\newlabel{fig:sch-cb-pnp}{{5}{7}{Common-base circuits for the PNP transistor: (a) input-characteristic circuit, $|V_{CC}| = \SI {5}{\volt }$, $R_E = \SI {1}{\kilo \ohm }$, $V_{EE}$ swept; (b) output-characteristic circuit, $V_{EE} = \SI {0}{\volt }$ (stepped to \SI {5}{\volt }), $R_C = \SI {100}{\ohm }$, $V_{CC}$ swept. The source polarities and the current directions are reversed with respect to Figure~\ref {fig:sch-cb-npn}}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Common-emitter circuits for the PNP transistor: (a) input-characteristic circuit, $|V_{CC}|$ decade swept from 0.01 to \SI {1}{\volt } for the plotted family (the $|V_{CC}| = \SI {1}{\volt }$ curve is the reference for the input resistance), $R_B = \SI {10}{\kilo \ohm }$, $V_{BB}$ swept; (b) output-characteristic circuit, $|V_{BB}| = \SI {0}{\volt }$ (stepped to \SI {8}{\volt }), $R_B = \SI {100}{\kilo \ohm }$, $V_{CC}$ swept.}}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:sch-ce-pnp}{{6}{8}{Common-emitter circuits for the PNP transistor: (a) input-characteristic circuit, $|V_{CC}|$ decade swept from 0.01 to \SI {1}{\volt } for the plotted family (the $|V_{CC}| = \SI {1}{\volt }$ curve is the reference for the input resistance), $R_B = \SI {10}{\kilo \ohm }$, $V_{BB}$ swept; (b) output-characteristic circuit, $|V_{BB}| = \SI {0}{\volt }$ (stepped to \SI {8}{\volt }), $R_B = \SI {100}{\kilo \ohm }$, $V_{CC}$ swept}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Common-collector circuits for the PNP transistor: (a) input-characteristic circuit, collector grounded, $|V_{EE}| = \SI {0}{\volt }$ (stepped from \SI {1}{\volt } to \SI {4}{\volt }), $R_B = \SI {22}{\kilo \ohm }$, $V_{BB}$ swept; (b) output-characteristic circuit, $|V_{BB}| = \SI {0}{\volt }$ (stepped to \SI {74}{\volt }), $R_B = \SI {1}{\mega \ohm }$, $R_E = \SI {1}{\ohm }$, $V_{EE}$ swept.}}{8}{figure.caption.8}\protected@file@percent }
\newlabel{fig:sch-cc-pnp}{{7}{8}{Common-collector circuits for the PNP transistor: (a) input-characteristic circuit, collector grounded, $|V_{EE}| = \SI {0}{\volt }$ (stepped from \SI {1}{\volt } to \SI {4}{\volt }), $R_B = \SI {22}{\kilo \ohm }$, $V_{BB}$ swept; (b) output-characteristic circuit, $|V_{BB}| = \SI {0}{\volt }$ (stepped to \SI {74}{\volt }), $R_B = \SI {1}{\mega \ohm }$, $R_E = \SI {1}{\ohm }$, $V_{EE}$ swept}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7.6}Result Analysis}{9}{section.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.6.1}Simulated characteristics of the NPN transistor}{9}{subsection.6.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.6.1.1}Common-base (CB) configuration}{9}{subsubsection.6.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces PSpice output: input characteristic of the NPN transistor in CB configuration for $V_{CC} = 5$, 25 and \SI {45}{\volt } ($V_{CB} \approx V_{CC}$). The current rises exponentially above the knee and reaches \SI {4.3}{\milli \ampere } at \SI {0.703}{\volt }; the \SI {45}{\volt } curve lies about \SI {10}{\milli \volt } to the left of the \SI {5}{\volt } curve.}}{9}{figure.caption.9}\protected@file@percent }
\newlabel{fig:cb-in-npn}{{8}{9}{PSpice output: input characteristic of the NPN transistor in CB configuration for $V_{CC} = 5$, 25 and \SI {45}{\volt } ($V_{CB} \approx V_{CC}$). The current rises exponentially above the knee and reaches \SI {4.3}{\milli \ampere } at \SI {0.703}{\volt }; the \SI {45}{\volt } curve lies about \SI {10}{\milli \volt } to the left of the \SI {5}{\volt } curve}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces PSpice output: output characteristic of the NPN transistor in CB configuration for $V_{EE} = 0$ to \SI {5}{\volt }, i.e. $I_E \approx 0$ to \SI {4.3}{\milli \ampere }. The $V_{EE} = 0$ trace along the axis is the cutoff region, saturation lies at negative $V_{CB}$ with the knee at \SI {-0.63}{\volt }, and each active-region trace sits at $I_C \approx 0.994\,I_E$ with a small positive slope.}}{9}{figure.caption.10}\protected@file@percent }
\newlabel{fig:cb-out-npn}{{9}{9}{PSpice output: output characteristic of the NPN transistor in CB configuration for $V_{EE} = 0$ to \SI {5}{\volt }, i.e. $I_E \approx 0$ to \SI {4.3}{\milli \ampere }. The $V_{EE} = 0$ trace along the axis is the cutoff region, saturation lies at negative $V_{CB}$ with the knee at \SI {-0.63}{\volt }, and each active-region trace sits at $I_C \approx 0.994\,I_E$ with a small positive slope}{figure.caption.10}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.6.1.2}Common-emitter (CE) configuration}{10}{subsubsection.6.1.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces PSpice output: input characteristic of the NPN transistor in CE configuration for $V_{CC} = 0.01$, 0.1 and \SI {1}{\volt } (decade sweep, $V_{CE} \approx V_{CC}$). The curves move to the right as $V_{CC}$ increases because the forward bias of the collector junction falls. The two marked points on the $V_{CE} = \SI {1}{\volt }$ curve, \SI {709.95}{\milli \volt } at \SI {32.90}{\micro \ampere } and \SI {724.02}{\milli \volt } at \SI {52.76}{\micro \ampere }, are used for the input resistance.}}{10}{figure.caption.11}\protected@file@percent }
\newlabel{fig:ce-in-npn}{{10}{10}{PSpice output: input characteristic of the NPN transistor in CE configuration for $V_{CC} = 0.01$, 0.1 and \SI {1}{\volt } (decade sweep, $V_{CE} \approx V_{CC}$). The curves move to the right as $V_{CC}$ increases because the forward bias of the collector junction falls. The two marked points on the $V_{CE} = \SI {1}{\volt }$ curve, \SI {709.95}{\milli \volt } at \SI {32.90}{\micro \ampere } and \SI {724.02}{\milli \volt } at \SI {52.76}{\micro \ampere }, are used for the input resistance}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces PSpice output: output characteristic of the NPN transistor in CE configuration for $V_{BB} = 0$ to \SI {8}{\volt } ($I_B \approx 0$ to \SI {73}{\micro \ampere }). The knee at \SI {0.21}{\volt } separates the saturation region from the active region, where the traces are spaced by about \SI {3.5}{\milli \ampere } per \SI {20}{\micro \ampere }; the $V_{BB} = 0$ trace is the cutoff region.}}{10}{figure.caption.12}\protected@file@percent }
\newlabel{fig:ce-out-npn}{{11}{10}{PSpice output: output characteristic of the NPN transistor in CE configuration for $V_{BB} = 0$ to \SI {8}{\volt } ($I_B \approx 0$ to \SI {73}{\micro \ampere }). The knee at \SI {0.21}{\volt } separates the saturation region from the active region, where the traces are spaced by about \SI {3.5}{\milli \ampere } per \SI {20}{\micro \ampere }; the $V_{BB} = 0$ trace is the cutoff region}{figure.caption.12}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.6.1.3}Common-collector (CC) configuration}{11}{subsubsection.6.1.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces PSpice output: input characteristic of the NPN transistor in CC configuration for $V_{EE} = -1$, $-2$, $-3$ and \SI {-4}{\volt } ($V_{CE} = 1$, 2, 3 and \SI {4}{\volt }), plotted against $V_{BC}$. The curves are separated by about \SI {1}{\volt } because $V_{BC} = V_{BE} - V_{CE}$; the \SI {4}{\volt } curve is the leftmost.}}{11}{figure.caption.13}\protected@file@percent }
\newlabel{fig:cc-in-npn}{{12}{11}{PSpice output: input characteristic of the NPN transistor in CC configuration for $V_{EE} = -1$, $-2$, $-3$ and \SI {-4}{\volt } ($V_{CE} = 1$, 2, 3 and \SI {4}{\volt }), plotted against $V_{BC}$. The curves are separated by about \SI {1}{\volt } because $V_{BC} = V_{BE} - V_{CE}$; the \SI {4}{\volt } curve is the leftmost}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces PSpice output: output characteristic of the NPN transistor in CC configuration for $V_{BB} = -6$, 14, 34, 54 and \SI {74}{\volt } ($I_B \approx 0$ to \SI {74}{\micro \ampere }). The knee at \SI {0.22}{\volt } separates saturation from the active region, and the emitter current is the largest terminal current, about one base current above the corresponding CE value.}}{11}{figure.caption.14}\protected@file@percent }
\newlabel{fig:cc-out-npn}{{13}{11}{PSpice output: output characteristic of the NPN transistor in CC configuration for $V_{BB} = -6$, 14, 34, 54 and \SI {74}{\volt } ($I_B \approx 0$ to \SI {74}{\micro \ampere }). The knee at \SI {0.22}{\volt } separates saturation from the active region, and the emitter current is the largest terminal current, about one base current above the corresponding CE value}{figure.caption.14}{}}
