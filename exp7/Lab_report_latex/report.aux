\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces PSpice output: input characteristic of the NPN transistor in CB configuration for $V_{CC} = 5$, 25 and \SI {45}{\volt } ($V_{CB} \approx V_{CC}$). The current rises exponentially above the knee and reaches \SI {4.3}{\milli \ampere } at \SI {0.703}{\volt }; the \SI {45}{\volt } curve lies about \SI {10}{\milli \volt } to the left of the \SI {5}{\volt } curve through the Early effect.}}{14}{figure.caption.10}\protected@file@percent }
\newlabel{fig:cb-in-npn}{{7}{14}{PSpice output: input characteristic of the NPN transistor in CB configuration for $V_{CC} = 5$, 25 and \SI {45}{\volt } ($V_{CB} \approx V_{CC}$). The current rises exponentially above the knee and reaches \SI {4.3}{\milli \ampere } at \SI {0.703}{\volt }; the \SI {45}{\volt } curve lies about \SI {10}{\milli \volt } to the left of the \SI {5}{\volt } curve through the Early effect}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces PSpice output: output characteristic of the NPN transistor in CB configuration for $V_{EE} = 0$ to \SI {5}{\volt }, i.e. $I_E \approx 0$ to \SI {4.3}{\milli \ampere }. The $V_{EE} = 0$ trace along the axis is the cutoff region, saturation lies at negative $V_{CB}$ with the knee at \SI {-0.63}{\volt }, and each active-region trace sits at $I_C \approx 0.994\,I_E$ with a small positive slope.}}{15}{figure.caption.11}\protected@file@percent }
\newlabel{fig:cb-out-npn}{{8}{15}{PSpice output: output characteristic of the NPN transistor in CB configuration for $V_{EE} = 0$ to \SI {5}{\volt }, i.e. $I_E \approx 0$ to \SI {4.3}{\milli \ampere }. The $V_{EE} = 0$ trace along the axis is the cutoff region, saturation lies at negative $V_{CB}$ with the knee at \SI {-0.63}{\volt }, and each active-region trace sits at $I_C \approx 0.994\,I_E$ with a small positive slope}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces PSpice output: input characteristic of the NPN transistor in CE configuration for $V_{CC} = 0.025$, 0.05, 0.1 and \SI {0.2}{\volt } (octave sweep, $V_{CE} \approx V_{CC}$). The curves move to the right as $V_{CC}$ increases because the forward bias of the collector junction falls; above about \SI {0.3}{\volt } the curves for larger $V_{CC}$ would merge into one.}}{15}{figure.caption.12}\protected@file@percent }
\newlabel{fig:ce-in-npn}{{9}{15}{PSpice output: input characteristic of the NPN transistor in CE configuration for $V_{CC} = 0.025$, 0.05, 0.1 and \SI {0.2}{\volt } (octave sweep, $V_{CE} \approx V_{CC}$). The curves move to the right as $V_{CC}$ increases because the forward bias of the collector junction falls; above about \SI {0.3}{\volt } the curves for larger $V_{CC}$ would merge into one}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces PSpice output: output characteristic of the NPN transistor in CE configuration for $V_{BB} = 0$ to \SI {8}{\volt } ($I_B \approx 0$ to \SI {73}{\micro \ampere }). The knee at \SI {0.21}{\volt } separates the saturation region from the active region, where the traces are spaced by about \SI {3.5}{\milli \ampere } per \SI {20}{\micro \ampere }; the $V_{BB} = 0$ trace is the cutoff region.}}{16}{figure.caption.13}\protected@file@percent }
\newlabel{fig:ce-out-npn}{{10}{16}{PSpice output: output characteristic of the NPN transistor in CE configuration for $V_{BB} = 0$ to \SI {8}{\volt } ($I_B \approx 0$ to \SI {73}{\micro \ampere }). The knee at \SI {0.21}{\volt } separates the saturation region from the active region, where the traces are spaced by about \SI {3.5}{\milli \ampere } per \SI {20}{\micro \ampere }; the $V_{BB} = 0$ trace is the cutoff region}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces PSpice output: input characteristic of the NPN transistor in CC configuration for $V_{EE} = -1$, $-2$, $-3$ and \SI {-4}{\volt } ($V_{CE} = 1$, 2, 3 and \SI {4}{\volt }), plotted against $V_{BC}$. The curves are separated by about \SI {1}{\volt } because $V_{BC} = V_{BE} - V_{CE}$; the \SI {4}{\volt } curve is the leftmost.}}{16}{figure.caption.14}\protected@file@percent }
\newlabel{fig:cc-in-npn}{{11}{16}{PSpice output: input characteristic of the NPN transistor in CC configuration for $V_{EE} = -1$, $-2$, $-3$ and \SI {-4}{\volt } ($V_{CE} = 1$, 2, 3 and \SI {4}{\volt }), plotted against $V_{BC}$. The curves are separated by about \SI {1}{\volt } because $V_{BC} = V_{BE} - V_{CE}$; the \SI {4}{\volt } curve is the leftmost}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces PSpice output: output characteristic of the NPN transistor in CC configuration for $V_{BB} = -6$, 14, 34, 54 and \SI {74}{\volt } ($I_B \approx 0$ to \SI {74}{\micro \ampere }). The knee at \SI {0.22}{\volt } separates saturation from the active region, and the emitter current is the largest terminal current, about one base current above the corresponding CE value.}}{17}{figure.caption.15}\protected@file@percent }
\newlabel{fig:cc-out-npn}{{12}{17}{PSpice output: output characteristic of the NPN transistor in CC configuration for $V_{BB} = -6$, 14, 34, 54 and \SI {74}{\volt } ($I_B \approx 0$ to \SI {74}{\micro \ampere }). The knee at \SI {0.22}{\volt } separates saturation from the active region, and the emitter current is the largest terminal current, about one base current above the corresponding CE value}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces PSpice output: input characteristic of the PNP transistor in CB configuration for $|V_{CC}| = 5$, 25 and \SI {45}{\volt }. The curve is the mirror image of Figure~\ref {fig:cb-in-npn} and the Early shift is larger, about \SI {25}{\milli \volt }, because the PNP Early voltage is only \SI {18.7}{\volt }.}}{18}{figure.caption.16}\protected@file@percent }
\newlabel{fig:cb-in-pnp}{{13}{18}{PSpice output: input characteristic of the PNP transistor in CB configuration for $|V_{CC}| = 5$, 25 and \SI {45}{\volt }. The curve is the mirror image of Figure~\ref {fig:cb-in-npn} and the Early shift is larger, about \SI {25}{\milli \volt }, because the PNP Early voltage is only \SI {18.7}{\volt }}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces PSpice output: output characteristic of the PNP transistor in CB configuration for $|V_{EE}| = 0$ to \SI {5}{\volt }. The saturation knee is at \SI {-0.71}{\volt } in the plotted coordinate and the active traces rise more steeply than for the NPN, because the PNP Early voltage is only \SI {18.7}{\volt }.}}{19}{figure.caption.17}\protected@file@percent }
\newlabel{fig:cb-out-pnp}{{14}{19}{PSpice output: output characteristic of the PNP transistor in CB configuration for $|V_{EE}| = 0$ to \SI {5}{\volt }. The saturation knee is at \SI {-0.71}{\volt } in the plotted coordinate and the active traces rise more steeply than for the NPN, because the PNP Early voltage is only \SI {18.7}{\volt }}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces PSpice output: input characteristic of the PNP transistor in CE configuration for $|V_{CC}| = 0.025$ to \SI {0.2}{\volt } (octave sweep, $|V_{CE}| \approx |V_{CC}|$). The curves spread to the right with increasing $|V_{CC}|$ in the same way as for the NPN.}}{19}{figure.caption.18}\protected@file@percent }
\newlabel{fig:ce-in-pnp}{{15}{19}{PSpice output: input characteristic of the PNP transistor in CE configuration for $|V_{CC}| = 0.025$ to \SI {0.2}{\volt } (octave sweep, $|V_{CE}| \approx |V_{CC}|$). The curves spread to the right with increasing $|V_{CC}|$ in the same way as for the NPN}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces PSpice output: output characteristic of the PNP transistor in CE configuration for $|V_{BB}| = 0$ to \SI {8}{\volt } ($|I_B| \approx 0$ to \SI {73}{\micro \ampere }). The spacing is about \SI {3.7}{\milli \ampere } per \SI {20}{\micro \ampere }, somewhat wider than the NPN spacing, and the traces rise more visibly with $|V_{CE}|$.}}{20}{figure.caption.19}\protected@file@percent }
\newlabel{fig:ce-out-pnp}{{16}{20}{PSpice output: output characteristic of the PNP transistor in CE configuration for $|V_{BB}| = 0$ to \SI {8}{\volt } ($|I_B| \approx 0$ to \SI {73}{\micro \ampere }). The spacing is about \SI {3.7}{\milli \ampere } per \SI {20}{\micro \ampere }, somewhat wider than the NPN spacing, and the traces rise more visibly with $|V_{CE}|$}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces PSpice output: input characteristic of the PNP transistor in CC configuration for $|V_{EE}| = 1$ to \SI {4}{\volt } ($|V_{CE}| = 1$ to \SI {4}{\volt }), plotted against $V_{BC}$; the four curves are separated by about \SI {1}{\volt }.}}{20}{figure.caption.20}\protected@file@percent }
\newlabel{fig:cc-in-pnp}{{17}{20}{PSpice output: input characteristic of the PNP transistor in CC configuration for $|V_{EE}| = 1$ to \SI {4}{\volt } ($|V_{CE}| = 1$ to \SI {4}{\volt }), plotted against $V_{BC}$; the four curves are separated by about \SI {1}{\volt }}{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces PSpice output: output characteristic of the PNP transistor in CC configuration for $|V_{BB}| = -6$, 14, 34, 54 and \SI {74}{\volt } ($|I_B| \approx 0$ to \SI {74}{\micro \ampere }). The emitter current reaches \SI {11.59}{\milli \ampere } at $|V_{CE}| = \SI {5}{\volt }$ for the 54 V step.}}{21}{figure.caption.21}\protected@file@percent }
\newlabel{fig:cc-out-pnp}{{18}{21}{PSpice output: output characteristic of the PNP transistor in CC configuration for $|V_{BB}| = -6$, 14, 34, 54 and \SI {74}{\volt } ($|I_B| \approx 0$ to \SI {74}{\micro \ampere }). The emitter current reaches \SI {11.59}{\milli \ampere } at $|V_{CE}| = \SI {5}{\volt }$ for the 54 V step}{figure.caption.21}{}}
