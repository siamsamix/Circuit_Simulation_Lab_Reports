\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Common-base circuits for the NPN transistor: (a) input-characteristic circuit, $V_{CB} = \SI {5}{\volt }$, $V_{EE}$ swept; (b) output-characteristic circuit, $I_{EE}$ set to \SI {1}{\milli \ampere }, $V_{CB}$ swept.}}{7}{figure.caption.3}\protected@file@percent }
\newlabel{fig:sch-cb-npn}{{1}{7}{Common-base circuits for the NPN transistor: (a) input-characteristic circuit, $V_{CB} = \SI {5}{\volt }$, $V_{EE}$ swept; (b) output-characteristic circuit, $I_{EE}$ set to \SI {1}{\milli \ampere }, $V_{CB}$ swept}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Common-emitter circuits for the NPN transistor: (a) input-characteristic circuit, $V_{CE} = \SI {5}{\volt }$, $V_{BB}$ swept; (b) output-characteristic circuit, $I_B = \SI {20}{\micro \ampere }$, $V_{CE}$ swept.}}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:sch-ce-npn}{{2}{7}{Common-emitter circuits for the NPN transistor: (a) input-characteristic circuit, $V_{CE} = \SI {5}{\volt }$, $V_{BB}$ swept; (b) output-characteristic circuit, $I_B = \SI {20}{\micro \ampere }$, $V_{CE}$ swept}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Common-collector circuits for the NPN transistor: (a) input-characteristic circuit, $V_{CE} = \SI {1}{\volt }$ (the emitter source $V_{CE}$ is \SI {-1}{\volt } because the collector is the ground reference), $V_{BB}$ swept; (b) output-characteristic circuit, $I_B = \SI {20}{\micro \ampere }$, $V_E$ swept with $V_{CC} = \SI {5}{\volt }$.}}{7}{figure.caption.5}\protected@file@percent }
\newlabel{fig:sch-cc-npn}{{3}{7}{Common-collector circuits for the NPN transistor: (a) input-characteristic circuit, $V_{CE} = \SI {1}{\volt }$ (the emitter source $V_{CE}$ is \SI {-1}{\volt } because the collector is the ground reference), $V_{BB}$ swept; (b) output-characteristic circuit, $I_B = \SI {20}{\micro \ampere }$, $V_E$ swept with $V_{CC} = \SI {5}{\volt }$}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Common-base circuits for the PNP transistor: (a) input-characteristic circuit, $|V_{CB}| = \SI {5}{\volt }$, $V_{EE}$ swept; (b) output-characteristic circuit, $|I_{EE}| = \SI {1}{\milli \ampere }$, $V_{CB}$ swept. The transistor symbol, the source polarities and the current directions are reversed with respect to Figure~\ref {fig:sch-cb-npn}.}}{8}{figure.caption.6}\protected@file@percent }
\newlabel{fig:sch-cb-pnp}{{4}{8}{Common-base circuits for the PNP transistor: (a) input-characteristic circuit, $|V_{CB}| = \SI {5}{\volt }$, $V_{EE}$ swept; (b) output-characteristic circuit, $|I_{EE}| = \SI {1}{\milli \ampere }$, $V_{CB}$ swept. The transistor symbol, the source polarities and the current directions are reversed with respect to Figure~\ref {fig:sch-cb-npn}}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Common-emitter circuits for the PNP transistor: (a) input-characteristic circuit, $|V_{CE}| = \SI {5}{\volt }$, $V_{BB}$ swept; (b) output-characteristic circuit, $|I_B| = \SI {20}{\micro \ampere }$ drawn out of the base, $V_{CE}$ swept.}}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:sch-ce-pnp}{{5}{8}{Common-emitter circuits for the PNP transistor: (a) input-characteristic circuit, $|V_{CE}| = \SI {5}{\volt }$, $V_{BB}$ swept; (b) output-characteristic circuit, $|I_B| = \SI {20}{\micro \ampere }$ drawn out of the base, $V_{CE}$ swept}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Common-collector circuits for the PNP transistor: (a) input-characteristic circuit, $|V_{CE}| = \SI {1}{\volt }$, $V_{BB}$ swept; (b) output-characteristic circuit, $|I_B| = \SI {20}{\micro \ampere }$ drawn out of the base, $V_E$ swept with $|V_{CC}| = \SI {5}{\volt }$.}}{8}{figure.caption.8}\protected@file@percent }
\newlabel{fig:sch-cc-pnp}{{6}{8}{Common-collector circuits for the PNP transistor: (a) input-characteristic circuit, $|V_{CE}| = \SI {1}{\volt }$, $V_{BB}$ swept; (b) output-characteristic circuit, $|I_B| = \SI {20}{\micro \ampere }$ drawn out of the base, $V_E$ swept with $|V_{CC}| = \SI {5}{\volt }$}{figure.caption.8}{}}
