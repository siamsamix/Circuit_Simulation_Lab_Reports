\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.6.2.1}Common-base (CB) configuration}{13}{subsubsection.6.2.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces PSpice output: input characteristic of the PNP transistor in CB configuration for $|V_{CC}| = 5$, 25 and \SI {45}{\volt }. The curve is the mirror image of Figure~\ref {fig:cb-in-npn} and the shift between the curves is larger, about \SI {25}{\milli \volt }.}}{13}{figure.caption.15}\protected@file@percent }
\newlabel{fig:cb-in-pnp}{{14}{13}{PSpice output: input characteristic of the PNP transistor in CB configuration for $|V_{CC}| = 5$, 25 and \SI {45}{\volt }. The curve is the mirror image of Figure~\ref {fig:cb-in-npn} and the shift between the curves is larger, about \SI {25}{\milli \volt }}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces PSpice output: output characteristic of the PNP transistor in CB configuration for $|V_{EE}| = 0$ to \SI {5}{\volt }. The saturation knee is at \SI {-0.71}{\volt } in the plotted coordinate and the active traces rise more steeply than for the NPN.}}{13}{figure.caption.16}\protected@file@percent }
\newlabel{fig:cb-out-pnp}{{15}{13}{PSpice output: output characteristic of the PNP transistor in CB configuration for $|V_{EE}| = 0$ to \SI {5}{\volt }. The saturation knee is at \SI {-0.71}{\volt } in the plotted coordinate and the active traces rise more steeply than for the NPN}{figure.caption.16}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.6.2.2}Common-emitter (CE) configuration}{14}{subsubsection.6.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces PSpice output: input characteristic of the PNP transistor in CE configuration for $|V_{CC}| = 0.01$, 0.1 and \SI {1}{\volt } (decade sweep, $|V_{CE}| \approx |V_{CC}|$). The curves spread to the right with increasing $|V_{CC}|$ in the same way as for the NPN. The two marked points on the $|V_{CE}| = \SI {1}{\volt }$ curve, \SI {751.89}{\milli \volt } at \SI {32.48}{\micro \ampere } and \SI {764.43}{\milli \volt } at \SI {52.36}{\micro \ampere }, are used for the input resistance.}}{14}{figure.caption.17}\protected@file@percent }
\newlabel{fig:ce-in-pnp}{{16}{14}{PSpice output: input characteristic of the PNP transistor in CE configuration for $|V_{CC}| = 0.01$, 0.1 and \SI {1}{\volt } (decade sweep, $|V_{CE}| \approx |V_{CC}|$). The curves spread to the right with increasing $|V_{CC}|$ in the same way as for the NPN. The two marked points on the $|V_{CE}| = \SI {1}{\volt }$ curve, \SI {751.89}{\milli \volt } at \SI {32.48}{\micro \ampere } and \SI {764.43}{\milli \volt } at \SI {52.36}{\micro \ampere }, are used for the input resistance}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces PSpice output: output characteristic of the PNP transistor in CE configuration for $|V_{BB}| = 0$ to \SI {8}{\volt } ($|I_B| \approx 0$ to \SI {73}{\micro \ampere }). The spacing is about \SI {3.7}{\milli \ampere } per \SI {20}{\micro \ampere }, somewhat wider than the NPN spacing, and the traces rise more visibly with $|V_{CE}|$.}}{14}{figure.caption.18}\protected@file@percent }
\newlabel{fig:ce-out-pnp}{{17}{14}{PSpice output: output characteristic of the PNP transistor in CE configuration for $|V_{BB}| = 0$ to \SI {8}{\volt } ($|I_B| \approx 0$ to \SI {73}{\micro \ampere }). The spacing is about \SI {3.7}{\milli \ampere } per \SI {20}{\micro \ampere }, somewhat wider than the NPN spacing, and the traces rise more visibly with $|V_{CE}|$}{figure.caption.18}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.6.2.3}Common-collector (CC) configuration}{15}{subsubsection.6.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces PSpice output: input characteristic of the PNP transistor in CC configuration for $|V_{EE}| = 1$ to \SI {4}{\volt } ($|V_{CE}| = 1$ to \SI {4}{\volt }), plotted against $V_{CB} = -V_{BC}$ (the axis of the figure); the four curves are separated by about \SI {1}{\volt }.}}{15}{figure.caption.19}\protected@file@percent }
\newlabel{fig:cc-in-pnp}{{18}{15}{PSpice output: input characteristic of the PNP transistor in CC configuration for $|V_{EE}| = 1$ to \SI {4}{\volt } ($|V_{CE}| = 1$ to \SI {4}{\volt }), plotted against $V_{CB} = -V_{BC}$ (the axis of the figure); the four curves are separated by about \SI {1}{\volt }}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces PSpice output: output characteristic of the PNP transistor in CC configuration for $V_{BB} = -6$, 14, 34, 54 and \SI {74}{\volt } (source values with reversed battery polarity; $|I_B| \approx 0$ to \SI {74}{\micro \ampere }). The emitter current reaches \SI {11.59}{\milli \ampere } at $|V_{CE}| = \SI {5}{\volt }$ for the 54 V step.}}{15}{figure.caption.20}\protected@file@percent }
\newlabel{fig:cc-out-pnp}{{19}{15}{PSpice output: output characteristic of the PNP transistor in CC configuration for $V_{BB} = -6$, 14, 34, 54 and \SI {74}{\volt } (source values with reversed battery polarity; $|I_B| \approx 0$ to \SI {74}{\micro \ampere }). The emitter current reaches \SI {11.59}{\milli \ampere } at $|V_{CE}| = \SI {5}{\volt }$ for the 54 V step}{figure.caption.20}{}}
