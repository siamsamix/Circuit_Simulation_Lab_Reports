\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Common-base circuits for the NPN transistor: (a) input-characteristic circuit, $V_{CB} = \SI {5}{\volt }$, $V_{EE}$ swept; (b) output-characteristic circuit, $I_{EE}$ set to \SI {1}{\milli \ampere }, $V_{CB}$ swept.}}{5}{figure.caption.2}\protected@file@percent }
\newlabel{fig:sch-cb-npn}{{1}{5}{Common-base circuits for the NPN transistor: (a) input-characteristic circuit, $V_{CB} = \SI {5}{\volt }$, $V_{EE}$ swept; (b) output-characteristic circuit, $I_{EE}$ set to \SI {1}{\milli \ampere }, $V_{CB}$ swept}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Common-emitter circuits for the NPN transistor: (a) input-characteristic circuit, $V_{CE} = \SI {5}{\volt }$, $V_{BB}$ swept; (b) output-characteristic circuit, $I_B = \SI {20}{\micro \ampere }$, $V_{CE}$ swept.}}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:sch-ce-npn}{{2}{5}{Common-emitter circuits for the NPN transistor: (a) input-characteristic circuit, $V_{CE} = \SI {5}{\volt }$, $V_{BB}$ swept; (b) output-characteristic circuit, $I_B = \SI {20}{\micro \ampere }$, $V_{CE}$ swept}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Common-collector circuits for the NPN transistor: (a) input-characteristic circuit, $V_{CE} = \SI {1}{\volt }$, $V_{BB}$ swept; (b) output-characteristic circuit, $I_B = \SI {20}{\micro \ampere }$, $V_E$ swept with $V_{CC} = \SI {5}{\volt }$.}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:sch-cc-npn}{{3}{5}{Common-collector circuits for the NPN transistor: (a) input-characteristic circuit, $V_{CE} = \SI {1}{\volt }$, $V_{BB}$ swept; (b) output-characteristic circuit, $I_B = \SI {20}{\micro \ampere }$, $V_E$ swept with $V_{CC} = \SI {5}{\volt }$}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Common-base circuits for the PNP transistor: (a) input-characteristic circuit, $|V_{CB}| = \SI {5}{\volt }$, $V_{EE}$ swept; (b) output-characteristic circuit, $I_{EE} = \SI {1}{\milli \ampere }$, $V_{CB}$ swept. All sources are reversed with respect to Figure~\ref {fig:sch-cb-npn}.}}{6}{figure.caption.5}\protected@file@percent }
\newlabel{fig:sch-cb-pnp}{{4}{6}{Common-base circuits for the PNP transistor: (a) input-characteristic circuit, $|V_{CB}| = \SI {5}{\volt }$, $V_{EE}$ swept; (b) output-characteristic circuit, $I_{EE} = \SI {1}{\milli \ampere }$, $V_{CB}$ swept. All sources are reversed with respect to Figure~\ref {fig:sch-cb-npn}}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Common-emitter circuits for the PNP transistor: (a) input-characteristic circuit, $|V_{CE}| = \SI {5}{\volt }$, $V_{BB}$ swept; (b) output-characteristic circuit, $I_B = \SI {20}{\micro \ampere }$, $V_{CE}$ swept.}}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:sch-ce-pnp}{{5}{6}{Common-emitter circuits for the PNP transistor: (a) input-characteristic circuit, $|V_{CE}| = \SI {5}{\volt }$, $V_{BB}$ swept; (b) output-characteristic circuit, $I_B = \SI {20}{\micro \ampere }$, $V_{CE}$ swept}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Common-collector circuits for the PNP transistor: (a) input-characteristic circuit, $|V_{CE}| = \SI {1}{\volt }$, $V_{BB}$ swept; (b) output-characteristic circuit, $I_B = \SI {20}{\micro \ampere }$, $V_E$ swept with $|V_{CC}| = \SI {5}{\volt }$.}}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:sch-cc-pnp}{{6}{6}{Common-collector circuits for the PNP transistor: (a) input-characteristic circuit, $|V_{CE}| = \SI {1}{\volt }$, $V_{BB}$ swept; (b) output-characteristic circuit, $I_B = \SI {20}{\micro \ampere }$, $V_E$ swept with $|V_{CC}| = \SI {5}{\volt }$}{figure.caption.7}{}}
