\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces PSpice output: input characteristic of the NPN transistor in CB configuration for $V_{CC} = 5$, 25 and \SI {45}{\volt } ($V_{CB} \approx V_{CC}$). The current rises exponentially above the knee and reaches \SI {4.3}{\milli \ampere } at \SI {0.703}{\volt }; the \SI {45}{\volt } curve lies about \SI {10}{\milli \volt } to the left of the \SI {5}{\volt } curve.}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:cb-in-npn}{{7}{7}{PSpice output: input characteristic of the NPN transistor in CB configuration for $V_{CC} = 5$, 25 and \SI {45}{\volt } ($V_{CB} \approx V_{CC}$). The current rises exponentially above the knee and reaches \SI {4.3}{\milli \ampere } at \SI {0.703}{\volt }; the \SI {45}{\volt } curve lies about \SI {10}{\milli \volt } to the left of the \SI {5}{\volt } curve}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces PSpice output: output characteristic of the NPN transistor in CB configuration for $V_{EE} = 0$ to \SI {5}{\volt }, i.e. $I_E \approx 0$ to \SI {4.3}{\milli \ampere }. The $V_{EE} = 0$ trace along the axis is the cutoff region, saturation lies at negative $V_{CB}$ with the knee at \SI {-0.63}{\volt }, and each active-region trace sits at $I_C \approx 0.994\,I_E$ with a small positive slope.}}{8}{figure.caption.9}\protected@file@percent }
\newlabel{fig:cb-out-npn}{{8}{8}{PSpice output: output characteristic of the NPN transistor in CB configuration for $V_{EE} = 0$ to \SI {5}{\volt }, i.e. $I_E \approx 0$ to \SI {4.3}{\milli \ampere }. The $V_{EE} = 0$ trace along the axis is the cutoff region, saturation lies at negative $V_{CB}$ with the knee at \SI {-0.63}{\volt }, and each active-region trace sits at $I_C \approx 0.994\,I_E$ with a small positive slope}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.6.1.2}Common-emitter (CE) configuration}{8}{subsubsection.6.1.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces PSpice output: input characteristic of the NPN transistor in CE configuration for $V_{CC} = 0.01$, 0.1 and \SI {1}{\volt } (decade sweep, $V_{CE} \approx V_{CC}$). The curves move to the right as $V_{CC}$ increases because the forward bias of the collector junction falls. The two marked points on the $V_{CE} = \SI {1}{\volt }$ curve, \SI {709.95}{\milli \volt } at \SI {32.90}{\micro \ampere } and \SI {724.02}{\milli \volt } at \SI {52.76}{\micro \ampere }, are used for the input resistance.}}{8}{figure.caption.10}\protected@file@percent }
\newlabel{fig:ce-in-npn}{{9}{8}{PSpice output: input characteristic of the NPN transistor in CE configuration for $V_{CC} = 0.01$, 0.1 and \SI {1}{\volt } (decade sweep, $V_{CE} \approx V_{CC}$). The curves move to the right as $V_{CC}$ increases because the forward bias of the collector junction falls. The two marked points on the $V_{CE} = \SI {1}{\volt }$ curve, \SI {709.95}{\milli \volt } at \SI {32.90}{\micro \ampere } and \SI {724.02}{\milli \volt } at \SI {52.76}{\micro \ampere }, are used for the input resistance}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces PSpice output: output characteristic of the NPN transistor in CE configuration for $V_{BB} = 0$ to \SI {8}{\volt } ($I_B \approx 0$ to \SI {73}{\micro \ampere }). The knee at \SI {0.21}{\volt } separates the saturation region from the active region, where the traces are spaced by about \SI {3.5}{\milli \ampere } per \SI {20}{\micro \ampere }; the $V_{BB} = 0$ trace is the cutoff region.}}{9}{figure.caption.11}\protected@file@percent }
\newlabel{fig:ce-out-npn}{{10}{9}{PSpice output: output characteristic of the NPN transistor in CE configuration for $V_{BB} = 0$ to \SI {8}{\volt } ($I_B \approx 0$ to \SI {73}{\micro \ampere }). The knee at \SI {0.21}{\volt } separates the saturation region from the active region, where the traces are spaced by about \SI {3.5}{\milli \ampere } per \SI {20}{\micro \ampere }; the $V_{BB} = 0$ trace is the cutoff region}{figure.caption.11}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.6.1.3}Common-collector (CC) configuration}{9}{subsubsection.6.1.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces PSpice output: input characteristic of the NPN transistor in CC configuration for $V_{EE} = -1$, $-2$, $-3$ and \SI {-4}{\volt } ($V_{CE} = 1$, 2, 3 and \SI {4}{\volt }), plotted against $V_{BC}$. The curves are separated by about \SI {1}{\volt } because $V_{BC} = V_{BE} - V_{CE}$; the \SI {4}{\volt } curve is the leftmost.}}{9}{figure.caption.12}\protected@file@percent }
\newlabel{fig:cc-in-npn}{{11}{9}{PSpice output: input characteristic of the NPN transistor in CC configuration for $V_{EE} = -1$, $-2$, $-3$ and \SI {-4}{\volt } ($V_{CE} = 1$, 2, 3 and \SI {4}{\volt }), plotted against $V_{BC}$. The curves are separated by about \SI {1}{\volt } because $V_{BC} = V_{BE} - V_{CE}$; the \SI {4}{\volt } curve is the leftmost}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces PSpice output: output characteristic of the NPN transistor in CC configuration for $V_{BB} = -6$, 14, 34, 54 and \SI {74}{\volt } ($I_B \approx 0$ to \SI {74}{\micro \ampere }). The knee at \SI {0.22}{\volt } separates saturation from the active region, and the emitter current is the largest terminal current, about one base current above the corresponding CE value.}}{10}{figure.caption.13}\protected@file@percent }
\newlabel{fig:cc-out-npn}{{12}{10}{PSpice output: output characteristic of the NPN transistor in CC configuration for $V_{BB} = -6$, 14, 34, 54 and \SI {74}{\volt } ($I_B \approx 0$ to \SI {74}{\micro \ampere }). The knee at \SI {0.22}{\volt } separates saturation from the active region, and the emitter current is the largest terminal current, about one base current above the corresponding CE value}{figure.caption.13}{}}
