\newlabel{fig:sch-cb-pnp}{{4}{6}{Common-base circuits for the PNP transistor: (a) input-characteristic circuit, $|V_{CC}| = \SI {5}{\volt }$, $R_E = \SI {1}{\kilo \ohm }$, $V_{EE}$ swept; (b) output-characteristic circuit, $V_{EE} = \SI {0}{\volt }$ (stepped to \SI {5}{\volt }), $R_C = \SI {100}{\ohm }$, $V_{CC}$ swept. The source polarities and the current directions are reversed with respect to Figure~\ref {fig:sch-cb-npn}}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Common-emitter circuits for the PNP transistor: (a) input-characteristic circuit, $|V_{CC}|$ decade swept from 0.01 to \SI {1}{\volt } for the plotted family (the $|V_{CC}| = \SI {1}{\volt }$ curve is the reference for the input resistance), $R_B = \SI {10}{\kilo \ohm }$, $V_{BB}$ swept; (b) output-characteristic circuit, $|V_{BB}| = \SI {0}{\volt }$ (stepped to \SI {8}{\volt }), $R_B = \SI {100}{\kilo \ohm }$, $V_{CC}$ swept.}}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:sch-ce-pnp}{{5}{6}{Common-emitter circuits for the PNP transistor: (a) input-characteristic circuit, $|V_{CC}|$ decade swept from 0.01 to \SI {1}{\volt } for the plotted family (the $|V_{CC}| = \SI {1}{\volt }$ curve is the reference for the input resistance), $R_B = \SI {10}{\kilo \ohm }$, $V_{BB}$ swept; (b) output-characteristic circuit, $|V_{BB}| = \SI {0}{\volt }$ (stepped to \SI {8}{\volt }), $R_B = \SI {100}{\kilo \ohm }$, $V_{CC}$ swept}{figure.caption.6}{}}
