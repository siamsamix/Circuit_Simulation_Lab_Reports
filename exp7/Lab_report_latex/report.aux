\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces PSpice output: input characteristic of the NPN transistor in CB configuration for $V_{CB} = 5$ and \SI {10}{\volt }. The current is negligible below the \SI {0.5}{\volt } knee and rises exponentially above it; the \SI {10}{\volt } curve lies slightly to the left because of the Early effect.}}{11}{figure.caption.8}\protected@file@percent }
\newlabel{fig:cb-in-npn}{{7}{11}{PSpice output: input characteristic of the NPN transistor in CB configuration for $V_{CB} = 5$ and \SI {10}{\volt }. The current is negligible below the \SI {0.5}{\volt } knee and rises exponentially above it; the \SI {10}{\volt } curve lies slightly to the left because of the Early effect}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces PSpice output: output characteristic of the NPN transistor in CB configuration for $I_E = 1$ to \SI {5}{\milli \ampere }. The saturation region lies at negative $V_{CB}$, the active region is almost flat and slightly rising, and each trace sits at $I_C \approx 0.994\,I_E$.}}{12}{figure.caption.9}\protected@file@percent }
\newlabel{fig:cb-out-npn}{{8}{12}{PSpice output: output characteristic of the NPN transistor in CB configuration for $I_E = 1$ to \SI {5}{\milli \ampere }. The saturation region lies at negative $V_{CB}$, the active region is almost flat and slightly rising, and each trace sits at $I_C \approx 0.994\,I_E$}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces PSpice output: input characteristic of the NPN transistor in CE configuration for $V_{CE} = 5$ and \SI {20}{\volt }. The base current reaches \SI {125}{\micro \ampere } at \SI {0.75}{\volt }, and the two curves nearly coincide because the Early effect on the base current is small.}}{12}{figure.caption.10}\protected@file@percent }
\newlabel{fig:ce-in-npn}{{9}{12}{PSpice output: input characteristic of the NPN transistor in CE configuration for $V_{CE} = 5$ and \SI {20}{\volt }. The base current reaches \SI {125}{\micro \ampere } at \SI {0.75}{\volt }, and the two curves nearly coincide because the Early effect on the base current is small}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces PSpice output: output characteristic of the NPN transistor in CE configuration for $I_B = 20$ to \SI {80}{\micro \ampere }. The knee at about \SI {0.2}{\volt } separates the saturation region from the active region, where the traces are flat and equally spaced by about \SI {3.4}{\milli \ampere } per \SI {20}{\micro \ampere }.}}{13}{figure.caption.11}\protected@file@percent }
\newlabel{fig:ce-out-npn}{{10}{13}{PSpice output: output characteristic of the NPN transistor in CE configuration for $I_B = 20$ to \SI {80}{\micro \ampere }. The knee at about \SI {0.2}{\volt } separates the saturation region from the active region, where the traces are flat and equally spaced by about \SI {3.4}{\milli \ampere } per \SI {20}{\micro \ampere }}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces PSpice output: input characteristic of the NPN transistor in CC configuration for $V_{CE} = 1, 2, 5, 10$ and \SI {20}{\volt }. The five curves are practically identical, which confirms that the base current is set by the base-emitter voltage alone.}}{13}{figure.caption.12}\protected@file@percent }
\newlabel{fig:cc-in-npn}{{11}{13}{PSpice output: input characteristic of the NPN transistor in CC configuration for $V_{CE} = 1, 2, 5, 10$ and \SI {20}{\volt }. The five curves are practically identical, which confirms that the base current is set by the base-emitter voltage alone}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces PSpice output: output characteristic of the NPN transistor in CC configuration for $I_B = 20$ to \SI {80}{\micro \ampere }. The emitter current is the largest terminal current, so the traces lie about one base current above the corresponding CE traces.}}{14}{figure.caption.13}\protected@file@percent }
\newlabel{fig:cc-out-npn}{{12}{14}{PSpice output: output characteristic of the NPN transistor in CC configuration for $I_B = 20$ to \SI {80}{\micro \ampere }. The emitter current is the largest terminal current, so the traces lie about one base current above the corresponding CE traces}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces PSpice output: input characteristic of the PNP transistor in CB configuration for $|V_{CB}| = 5$ and \SI {10}{\volt }. The curve is the mirror image of Figure~\ref {fig:cb-in-npn} and reaches \SI {9.6}{\milli \ampere } at \SI {0.76}{\volt }.}}{15}{figure.caption.14}\protected@file@percent }
\newlabel{fig:cb-in-pnp}{{13}{15}{PSpice output: input characteristic of the PNP transistor in CB configuration for $|V_{CB}| = 5$ and \SI {10}{\volt }. The curve is the mirror image of Figure~\ref {fig:cb-in-npn} and reaches \SI {9.6}{\milli \ampere } at \SI {0.76}{\volt }}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces PSpice output: output characteristic of the PNP transistor in CB configuration for $|I_E| = 1$ to \SI {5}{\milli \ampere }. The saturation region now lies at positive $V_{CB}$ and the traces rise more steeply in the active region than for the NPN, because the PNP Early voltage is only \SI {18.7}{\volt }.}}{15}{figure.caption.15}\protected@file@percent }
\newlabel{fig:cb-out-pnp}{{14}{15}{PSpice output: output characteristic of the PNP transistor in CB configuration for $|I_E| = 1$ to \SI {5}{\milli \ampere }. The saturation region now lies at positive $V_{CB}$ and the traces rise more steeply in the active region than for the NPN, because the PNP Early voltage is only \SI {18.7}{\volt }}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces PSpice output: input characteristic of the PNP transistor in CE configuration for $|V_{CE}| = 5$ and \SI {20}{\volt }. The base current reaches \SI {197}{\micro \ampere } at \SI {0.80}{\volt }, slightly above the NPN value.}}{16}{figure.caption.16}\protected@file@percent }
\newlabel{fig:ce-in-pnp}{{15}{16}{PSpice output: input characteristic of the PNP transistor in CE configuration for $|V_{CE}| = 5$ and \SI {20}{\volt }. The base current reaches \SI {197}{\micro \ampere } at \SI {0.80}{\volt }, slightly above the NPN value}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces PSpice output: output characteristic of the PNP transistor in CE configuration for $|I_B| = 20$ to \SI {80}{\micro \ampere }. The spacing is about \SI {3.9}{\milli \ampere } per \SI {20}{\micro \ampere }, somewhat wider than the NPN spacing, and the traces rise more visibly with $|V_{CE}|$.}}{16}{figure.caption.17}\protected@file@percent }
\newlabel{fig:ce-out-pnp}{{16}{16}{PSpice output: output characteristic of the PNP transistor in CE configuration for $|I_B| = 20$ to \SI {80}{\micro \ampere }. The spacing is about \SI {3.9}{\milli \ampere } per \SI {20}{\micro \ampere }, somewhat wider than the NPN spacing, and the traces rise more visibly with $|V_{CE}|$}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces PSpice output: input characteristic of the PNP transistor in CC configuration for $|V_{CE}| = 1, 2, 5, 10$ and \SI {20}{\volt }. As in the NPN case, the five curves coincide.}}{17}{figure.caption.18}\protected@file@percent }
\newlabel{fig:cc-in-pnp}{{17}{17}{PSpice output: input characteristic of the PNP transistor in CC configuration for $|V_{CE}| = 1, 2, 5, 10$ and \SI {20}{\volt }. As in the NPN case, the five curves coincide}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces PSpice output: output characteristic of the PNP transistor in CC configuration for $|I_B| = 20$ to \SI {80}{\micro \ampere }. The emitter current reaches \SI {11.25}{\milli \ampere } at $|V_{CE}| = \SI {3}{\volt }$ for $|I_B| = \SI {60}{\micro \ampere }$.}}{17}{figure.caption.19}\protected@file@percent }
\newlabel{fig:cc-out-pnp}{{18}{17}{PSpice output: output characteristic of the PNP transistor in CC configuration for $|I_B| = 20$ to \SI {80}{\micro \ampere }. The emitter current reaches \SI {11.25}{\milli \ampere } at $|V_{CE}| = \SI {3}{\volt }$ for $|I_B| = \SI {60}{\micro \ampere }$}{figure.caption.19}{}}
