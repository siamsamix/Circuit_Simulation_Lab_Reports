* Common-collector output characteristic (PNP 2N3906)
* I_B = 20 uA
IB 0 b -2e-05
Q1 c b e Q2N3906
VC c 0 -5
VE e 0 0
.MODEL Q2N3906 PNP(IS=1.41F XTI=3 EG=1.11 VAF=18.7 BF=180.7 NE=1.5
+ ISE=0 IKF=.12 XTB=1.5 BR=4 NC=2 ISC=0 IKR=0 RC=2.5
+ CJC=9.728P MJC=.5776 VJC=.75 FC=.5 CJE=8.063P MJE=.3677 VJE=.75
+ TR=33.42N TF=179.3P ITF=.4 VTF=4 XTF=2 RB=8.9)
.SAVE all @q1[ic] @q1[ib] @q1[ie]
.DC VE 0 -5 -0.025
.PROBE
.END
