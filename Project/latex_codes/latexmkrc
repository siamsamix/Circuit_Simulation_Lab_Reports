# ---------------------------------------------------------------
# latexmk configuration for the modular lab-report build
#
#   full build:   latexmk                (from this directory)
#   fast partial: edit the \quickbuild{} selector in
#                 signal_generator_project.tex, run latexmk
#   clean cache:  latexmk -C  &&  rm -rf figures/*.pdf
# ---------------------------------------------------------------
$pdf_mode   = 1;                                # pdfLaTeX
$pdflatex   = 'pdflatex -shell-escape %O %S';   # -shell-escape is required by TikZ externalization
$bibtex_use = 0;                                # no bibliography
