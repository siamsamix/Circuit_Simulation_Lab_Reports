\newlabel{sec:sim}{{7}{14}{Circuit-level simulation with 2N2222 models}{section.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.1}Power supply}{15}{subsection.7.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Simulated supply with the signal chain connected as its load (two mains cycles). The filter ripple is 0.64\,V$_{pp}$ around 16.1\,V and the rail is 12.01\,V with 37\,mV$_{pp}$ of ripple.}}{15}{figure.18}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.2}Signal chain}{15}{subsection.7.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Simulated waveforms at the five test points with 2N2222 and 1N4148 models (settled state, three periods). The dashed curve on TP5 is the hand model of Section~\ref {sec:wave}; the two agree closely.}}{15}{figure.19}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces Harmonics of the simulated output. The second harmonic (1.5\,\%) comes mainly from $Q_1$, which swings $\pm $1.5\,mA on a 2\,mA bias; the third (1.0\,\%) is the residual of the piecewise-linear shaping. Total THD = 2.0\,\%.}}{16}{figure.20}\protected@file@percent }
