\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces PSpice schematic of the pulse-driven RC circuit (Task 3): pulse source V1 (0--\SI {5}{\volt }, width \SI {5}{\milli \second }, period \SI {10}{\milli \second }) in series with R1 = \SI {1}{\kilo \ohm } and C1 = \SI {1}{\micro \farad }.}}{1}{figure.caption.2}\protected@file@percent }
\newlabel{fig:schematic-pulse}{{2}{1}{PSpice schematic of the pulse-driven RC circuit (Task 3): pulse source V1 (0--\SI {5}{\volt }, width \SI {5}{\milli \second }, period \SI {10}{\milli \second }) in series with R1 = \SI {1}{\kilo \ohm } and C1 = \SI {1}{\micro \farad }}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces PSpice schematic of the sinusoidally driven RC circuit (Tasks 4 and 5): V1 = $10\sin (2\mitpi \cdot 100 t - 70^{\circ })$~V, \SI {500}{\ohm } shunt resistor across the source, \SI {1}{\kilo \ohm } series resistor, and C1 = \SI {1}{\micro \farad }; Task 5 adds the initial condition \texttt  {IC = -8.2748}.}}{2}{figure.caption.3}\protected@file@percent }
\newlabel{fig:schematic-sine}{{3}{2}{PSpice schematic of the sinusoidally driven RC circuit (Tasks 4 and 5): V1 = $10\sin (2\pi \cdot 100 t - 70^{\circ })$~V, \SI {500}{\ohm } shunt resistor across the source, \SI {1}{\kilo \ohm } series resistor, and C1 = \SI {1}{\micro \farad }; Task 5 adds the initial condition \texttt {IC = -8.2748}}{figure.caption.3}{}}
