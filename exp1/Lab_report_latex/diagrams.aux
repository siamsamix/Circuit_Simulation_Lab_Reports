\newlabel{fig:schematic-task6a}{{4}{2}{PSpice schematic for Task 6a: \SI {20}{\volt } source, \SI {3}{\kilo \ohm } charging resistor, \SI {2}{\kilo \ohm } discharge resistor, and \SI {5}{\micro \farad } capacitor; U1 opens at \SI {75}{\milli \second } and U2 closes at \SI {76}{\milli \second }}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces PSpice schematic for Task 6b: pulse-driven RC circuit with R1 = \SI {100}{\ohm } and C1 = \SI {50}{\micro \farad }.}}{3}{figure.caption.5}\protected@file@percent }
\newlabel{fig:schematic-task6b}{{5}{3}{PSpice schematic for Task 6b: pulse-driven RC circuit with R1 = \SI {100}{\ohm } and C1 = \SI {50}{\micro \farad }}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces PSpice schematic for Tasks 6c and 6d: sinusoidal source with a \SI {1}{\kilo \ohm } shunt resistor, \SI {100}{\ohm } series resistor, and \SI {50}{\micro \farad } capacitor; Task 6d applies the initial capacitor voltage \SI {-5.935}{\volt }.}}{3}{figure.caption.6}\protected@file@percent }
\newlabel{fig:schematic-task6cd}{{6}{3}{PSpice schematic for Tasks 6c and 6d: sinusoidal source with a \SI {1}{\kilo \ohm } shunt resistor, \SI {100}{\ohm } series resistor, and \SI {50}{\micro \farad } capacitor; Task 6d applies the initial capacitor voltage \SI {-5.935}{\volt }}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Simulated transient response of the switching RC circuit (Task 1): capacitor voltage charging during $0$--\SI {6}{\milli \second }, holding between \SI {6}{\milli \second } and \SI {7}{\milli \second }, and discharging after \SI {7}{\milli \second }.}}{4}{figure.caption.7}\protected@file@percent }
\newlabel{fig:task12}{{7}{4}{Simulated transient response of the switching RC circuit (Task 1): capacitor voltage charging during $0$--\SI {6}{\milli \second }, holding between \SI {6}{\milli \second } and \SI {7}{\milli \second }, and discharging after \SI {7}{\milli \second }}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Simulated response of the RC circuit to the 0--\SI {5}{\volt } pulse train (Task 3): the capacitor charges during each \SI {5}{\milli \second } on-interval and discharges during each \SI {5}{\milli \second } off-interval.}}{4}{figure.caption.8}\protected@file@percent }
\newlabel{fig:task3}{{8}{4}{Simulated response of the RC circuit to the 0--\SI {5}{\volt } pulse train (Task 3): the capacitor charges during each \SI {5}{\milli \second } on-interval and discharges during each \SI {5}{\milli \second } off-interval}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Simulated response of the RC circuit to $10\sin (2\mitpi \cdot 100 t - 70^{\circ })$~\si {\volt } (Task 4): the capacitor voltage starts from zero and converges to the attenuated, phase-lagged steady-state sinusoid within about $5\mittau = \SI {5}{\milli \second }$.}}{5}{figure.caption.9}\protected@file@percent }
\newlabel{fig:task4}{{9}{5}{Simulated response of the RC circuit to $10\sin (2\pi \cdot 100 t - 70^{\circ })$~\si {\volt } (Task 4): the capacitor voltage starts from zero and converges to the attenuated, phase-lagged steady-state sinusoid within about $5\tau = \SI {5}{\milli \second }$}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Instantaneous power of the capacitor for the Task 4 run: after the transient dies out the power oscillates symmetrically about zero with a peak of \SI {22.5}{\milli \watt }, indicating no net energy absorption in the steady state.}}{5}{figure.caption.10}\protected@file@percent }
\newlabel{fig:task4power}{{10}{5}{Instantaneous power of the capacitor for the Task 4 run: after the transient dies out the power oscillates symmetrically about zero with a peak of \SI {22.5}{\milli \watt }, indicating no net energy absorption in the steady state}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Task 5: with the initial condition \texttt  {IC = -8.2748}, the capacitor voltage is a pure steady-state sinusoid from $t = 0$; no transient component is visible.}}{6}{figure.caption.11}\protected@file@percent }
\newlabel{fig:task5}{{11}{6}{Task 5: with the initial condition \texttt {IC = -8.2748}, the capacitor voltage is a pure steady-state sinusoid from $t = 0$; no transient component is visible}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Task 6a: response of the switching RC circuit with \SI {3}{\kilo \ohm } charging resistor, \SI {5}{\kilo \ohm } discharge path, $C = \SI {5}{\micro \farad }$, and \SI {20}{\volt } source: charging for \SI {75}{\milli \second } ($5\symup {\mittau }_{\mathit {charge}}$), hold for \SI {1}{\milli \second }, discharging with $\symup {\mittau }_{\mathit {discharge}} = \SI {25}{\milli \second }$.}}{6}{figure.caption.12}\protected@file@percent }
\newlabel{fig:task6a}{{12}{6}{Task 6a: response of the switching RC circuit with \SI {3}{\kilo \ohm } charging resistor, \SI {5}{\kilo \ohm } discharge path, $C = \SI {5}{\micro \farad }$, and \SI {20}{\volt } source: charging for \SI {75}{\milli \second } ($5\symup {\tau }_{\mathit {charge}}$), hold for \SI {1}{\milli \second }, discharging with $\symup {\tau }_{\mathit {discharge}} = \SI {25}{\milli \second }$}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Task 6b: response to the 0--\SI {5}{\volt } pulse train with $\mittau = \SI {5}{\milli \second }$; each \SI {25}{\milli \second } half-cycle lasts $5\mittau $, so the capacitor reaches $99.3\,\%$ of the pulse amplitude every cycle.}}{7}{figure.caption.13}\protected@file@percent }
\newlabel{fig:task6b}{{13}{7}{Task 6b: response to the 0--\SI {5}{\volt } pulse train with $\tau = \SI {5}{\milli \second }$; each \SI {25}{\milli \second } half-cycle lasts $5\tau $, so the capacitor reaches $99.3\,\%$ of the pulse amplitude every cycle}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Task 6c: response to $50\sin (2\mitpi \cdot 200 t - 50^{\circ })$~\si {\volt } with $\mittau = \SI {5}{\milli \second }$ ($\mitomega \mittau = 2\mitpi $): the steady-state capacitor voltage is attenuated to \SI {7.86}{\volt } and lags the source by $81^\circ $; the \SI {5.935}{\volt } transient decays with $\mittau = \SI {5}{\milli \second }$ and is still about \SI {15}{\milli \volt } at $t = \SI {30}{\milli \second }$.}}{7}{figure.caption.14}\protected@file@percent }
\newlabel{fig:task6c}{{14}{7}{Task 6c: response to $50\sin (2\pi \cdot 200 t - 50^{\circ })$~\si {\volt } with $\tau = \SI {5}{\milli \second }$ ($\omega \tau = 2\pi $): the steady-state capacitor voltage is attenuated to \SI {7.86}{\volt } and lags the source by $81^\circ $; the \SI {5.935}{\volt } transient decays with $\tau = \SI {5}{\milli \second }$ and is still about \SI {15}{\milli \volt } at $t = \SI {30}{\milli \second }$}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Task 6d: with \texttt  {.ic V(N002) = -5.935} the capacitor voltage is the pure steady-state sinusoid from $t = 0$; the transient of Fig.~\ref {fig:task6c} is absent.}}{8}{figure.caption.15}\protected@file@percent }
\newlabel{fig:task6d}{{15}{8}{Task 6d: with \texttt {.ic V(N002) = -5.935} the capacitor voltage is the pure steady-state sinusoid from $t = 0$; the transient of Fig.~\ref {fig:task6c} is absent}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Instantaneous capacitor power for Task 6d with the transient eliminated: the power alternates between positive and negative values as the capacitor stores and returns energy.}}{8}{figure.caption.16}\protected@file@percent }
\newlabel{fig:task6dpower}{{16}{8}{Instantaneous capacitor power for Task 6d with the transient eliminated: the power alternates between positive and negative values as the capacitor stores and returns energy}{figure.caption.16}{}}
